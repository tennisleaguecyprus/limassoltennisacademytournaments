// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TournamentFormat {
  KNOCKOUT
  ROUND_ROBIN_AND_KNOCKOUT
}

enum MatchSetupType {
  NORMAL_SET
  SHORT_SET_TO_4
  BEST_OF_3_SUPER_TIEBREAK
}

enum EventType {
  SINGLES
  DOUBLES
}

model Tournament {
  id           String           @id @default(cuid())
  name         String
  organizer    String?
  category     String?
  maxPlayers   Int?
  eventType    EventType        @default(SINGLES)
  format       TournamentFormat @default(KNOCKOUT)
  groupCount   Int?
  playersPerGroup Int?
  qualifiedPerGroup Int?
  qualifyBestSecond Boolean @default(false)
  qualifyBestThird  Boolean @default(false)
  matchSetupType MatchSetupType @default(NORMAL_SET)
  numberOfSets Int @default(1)
  standingsUseGamePoints Boolean @default(false)
  location     String?
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  players      Player[]
  matches      Match[]
}

model Player {
  id           String      @id @default(cuid())
  fullName     String
  partnerName  String?
  countryCode  String?     @db.VarChar(3)
  ranking      Int?
  groupNumber  Int?
  knockoutQualified Boolean @default(false)
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homeMatches  Match[]     @relation("home_player")
  awayMatches  Match[]     @relation("away_player")
}

model Match {
  id             String      @id @default(cuid())
  round          String
  scheduledAt    DateTime?
  court          Int?
  winnerId       String?
  homeGames      Int?
  awayGames      Int?
  tournamentId   String
  homePlayerId   String
  awayPlayerId   String
  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  homePlayer     Player      @relation("home_player", fields: [homePlayerId], references: [id], onDelete: Restrict)
  awayPlayer     Player      @relation("away_player", fields: [awayPlayerId], references: [id], onDelete: Restrict)
}

enum LadderStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LadderLevel {
  BEGINNER
  BEGINNER_INTERMEDIATE
  INTERMEDIATE
  ADVANCED
}

enum LadderChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

model Ladder {
  id                String         @id @default(cuid())
  name              String
  level             LadderLevel
  description       String?
  location          String?
  challengeRange    Int            @default(3)
  cooldownDays      Int            @default(3)
  inactivityDays    Int            @default(30)
  registrationOpen  Boolean        @default(true)
  maxPlayers        Int?
  status            LadderStatus   @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  players           LadderPlayer[]
  challenges        LadderChallenge[]

  @@index([level, status])
}

model LadderPlayer {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  countryCode  String?  @db.VarChar(3)
  position     Int
  paid         Boolean  @default(false)
  lastMatchAt  DateTime?
  active       Boolean  @default(true)
  registeredAt DateTime @default(now())
  ladderId     String
  ladder       Ladder   @relation(fields: [ladderId], references: [id], onDelete: Cascade)
  challengesAsChallenger LadderChallenge[] @relation("ladder_challenger")
  challengesAsChallenged LadderChallenge[] @relation("ladder_challenged")

  @@index([ladderId, position])
  @@index([ladderId, active])
}

model LadderChallenge {
  id                   String                @id @default(cuid())
  ladderId             String
  challengerId         String
  challengedId         String
  status               LadderChallengeStatus @default(PENDING)
  isFirstRound         Boolean               @default(false)
  scheduledAt          DateTime?
  court                Int?
  challengerSets       Int?
  challengedSets       Int?
  set1ChallengerGames  Int?
  set1ChallengedGames  Int?
  set2ChallengerGames  Int?
  set2ChallengedGames  Int?
  set3ChallengerGames  Int?
  set3ChallengedGames  Int?
  winnerId             String?
  completedAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  ladder               Ladder                @relation(fields: [ladderId], references: [id], onDelete: Cascade)
  challenger           LadderPlayer          @relation("ladder_challenger", fields: [challengerId], references: [id], onDelete: Restrict)
  challenged           LadderPlayer          @relation("ladder_challenged", fields: [challengedId], references: [id], onDelete: Restrict)

  @@index([ladderId, status])
  @@index([ladderId, isFirstRound])
}
